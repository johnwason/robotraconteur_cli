{
    "name": "robotraconteur-cli",
    "version": "0.1.0",
    "description": "rrac, a command line tool for finding and using Robot Raconteur services",
    "license": "Apache-2.0",
    "author": "Wason Technology, LLC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johnwason/robotraconteur_cli.git"
    },
    "homepage": "https://github.com/johnwason/robotraconteur_cli#readme",
    "bugs": "https://github.com/johnwason/robotraconteur_cli/issues",
    "keywords": [
        "robotraconteur",
        "robot raconteur",
        "robotics",
        "automation",
        "cli"
    ],
    "type": "module",
    "bin": {
        "rrac": "./dist/index.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "bundle": "node scripts/bundle.mjs",
        "prepare": "npm run build",
        "build:test": "npm run build && tsc -p tsconfig.test.json",
        "test:unit": "npm run build:test && node --test \"dist-test/test/unit/*.test.js\"",
        "test": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/unit/*.test.js\" \"dist-test/test/integration/*.test.js\""
    },
    "dependencies": {
        "robotraconteur": "0.1.0",
        "robotraconteur-node": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "22.10.2",
        "esbuild": "0.24.2",
        "typescript": "5.7.2"
    }
}
